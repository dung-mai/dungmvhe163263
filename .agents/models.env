# Model routing for scripts/ai/run.mjs (pnpm ai) and scripts/ai/step.sh. Change a line to move a lane to another engine.
# Engines:
#   claude      -> Claude Code on your Pro subscription
#   codex       -> Codex CLI on your Plus subscription
#   deepseek    -> OpenCode with a DeepSeek API key (pay per token)
#   deepseek-cc -> Claude Code pointed at DeepSeek (needs DEEPSEEK_CC_SETTINGS file)
# Rule: the engine that reviews must differ from the engine that built.

ENGINE_INTAKE=claude
ENGINE_DEFINE=claude
ENGINE_DESIGN=claude
ENGINE_TEST_PLAN=deepseek
ENGINE_BUILD=codex
ENGINE_VERIFY=claude
ENGINE_SECURITY=deepseek
ENGINE_PR=deepseek
ENGINE_RETRO=claude

# Optional model per lane, passed to that lane's engine (leave empty = engine default).
# Claude: opus | sonnet | haiku     Codex: a model id from `codex --help`/docs
# DeepSeek via OpenCode: provider/model, check ids with `opencode models deepseek`
# Claude lanes without a model use DEFAULT_MODEL_CLAUDE (below). Opus only where it pays off.
MODEL_DESIGN=opus
MODEL_VERIFY=sonnet
MODEL_TEST_PLAN=deepseek/deepseek-v4-flash
MODEL_SECURITY=deepseek/deepseek-v4-pro
MODEL_PR=deepseek/deepseek-v4-flash

# Fallback chain when an engine stops (quota, rate limit, crash). The orchestrator tries them in order.
# verify/security automatically skip the engine that built the code, to keep the review independent.
FALLBACK_DEFAULT="claude codex deepseek"
FALLBACK_BUILD="claude deepseek-cc"
FALLBACK_TEST_PLAN="codex claude"
FALLBACK_SECURITY="claude codex"
FALLBACK_PR="claude codex"

# Engines you cannot use on this machine (e.g. DeepSeek blocked on the office network): DISABLED_ENGINES="deepseek"
DISABLED_ENGINES=

# Model used when an engine runs as a fallback or the lane has no MODEL_* (keeps fallbacks off the priciest model)
DEFAULT_MODEL_CLAUDE=sonnet
DEFAULT_MODEL_CODEX=

# Orchestrator behaviour (scripts/ai/run.mjs)
MAX_FIX_ROUNDS=2            # verify/security -> build -> verify loops before asking you
LIMIT_COOLDOWN_MIN=60       # skip an engine this long after a quota limit or an access error (401/403, network)
LANE_TIMEOUT_MIN=25         # stop a lane that runs longer than this (0 = no limit); no fallback after a timeout
AUTO_COMMIT_ARTIFACTS=1     # commit work/<feature>/ after each approved gate
AUTO_COMMIT_BUILD=1         # orchestrator commits build changes (Codex's sandbox cannot write .git)
METRICS=1                   # Claude runs with stream-json to record tokens, cost and turns per lane
SECURITY_RISKS="auth_or_roles money"   # risks that turn the security lane on (profile full always runs it)
VERIFY_PORTS="3000 4000"    # checked before verify: stale dev servers make Playwright reuse old code
BUSY_PORTS=ask              # ask | kill | ignore

# Run budget: counted per invocation of `pnpm ai` (engine time and tokens, not time waiting at gates). Over it, the run stops
# and asks you; running `pnpm ai <f>` again starts a new count. 0 = no limit.
RUN_MAX_MIN=120
RUN_MAX_TOKENS_M=5          # millions of tokens (Claude input incl. cache + output, Codex total)
RUN_MAX_COST_USD=0          # API-equivalent dollars reported by Claude Code

# Sensors (deterministic checks the orchestrator runs itself)
READONLY_GUARD=stop         # stop | warn | off: intake/define/design/verify/security/pr must not change code under apps/ packages/
QA_FREEZE=stop              # stop | warn | off: build must not weaken QA-owned tests (fewer assertions, skip/only, deleted)
QA_INDEPENDENT=1            # test-plan avoids the engine that builds (ENGINE_BUILD)
AC_TRACE=warn               # off | warn | gate: every AC-n in spec.md needs a test that mentions it. gate = go back to build without paying for verify

# Notifications when a gate, a question or a stop needs you. bell = terminal beep, desktop = OS toast, ntfy = push to your phone
NOTIFY="bell desktop"
NTFY_TOPIC=                 # for ntfy: an unguessable topic name (anyone who knows it can read the messages)

# Engine defaults
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
CODEX_SANDBOX=workspace-write
# Path to a Claude Code settings file that points at DeepSeek (only for engine deepseek-cc)
DEEPSEEK_CC_SETTINGS=$HOME/.config/flashlab-ai/claude-deepseek.settings.json
