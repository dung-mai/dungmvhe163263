# Model routing for scripts/ai/step.sh. Change a line to move a lane to another engine.
# Engines:
#   claude      -> Claude Code on your Pro subscription
#   codex       -> Codex CLI on your Plus subscription
#   deepseek    -> OpenCode with a DeepSeek API key (pay per token)
#   deepseek-cc -> Claude Code pointed at DeepSeek (needs DEEPSEEK_CC_SETTINGS file)
# Rule: the engine that reviews must differ from the engine that built.

ENGINE_INTAKE=claude
ENGINE_DEFINE=claude
ENGINE_DESIGN=claude
ENGINE_TEST_PLAN=deepseek
ENGINE_BUILD=codex
ENGINE_VERIFY=claude
ENGINE_SECURITY=deepseek
ENGINE_PR=deepseek
ENGINE_RETRO=claude

# Optional model per lane, passed to that lane's engine (leave empty = engine default).
# Claude: opus | sonnet | haiku     Codex: a model id from `codex --help`/docs
# DeepSeek via OpenCode: provider/model, check ids with `opencode models deepseek`
MODEL_DESIGN=
MODEL_VERIFY=
MODEL_TEST_PLAN=deepseek/deepseek-v4-flash
MODEL_SECURITY=deepseek/deepseek-v4-pro
MODEL_PR=deepseek/deepseek-v4-flash

# Engine defaults
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
CODEX_SANDBOX=workspace-write
# Path to a Claude Code settings file that points at DeepSeek (only for engine deepseek-cc)
DEEPSEEK_CC_SETTINGS=$HOME/.config/flashlab-ai/claude-deepseek.settings.json
