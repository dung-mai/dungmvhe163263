{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "pnpm lint*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm test*": "allow",
      "pnpm --filter*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git merge-base*": "allow",
      "ls*": "allow",
      "node .agents/sensors/*": "allow",
      "pnpm verify*": "allow"
    }
  }
}
