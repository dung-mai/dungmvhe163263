{
  "name": "@flashlab/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm build && concurrently --kill-others \"tsc --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "node scripts/test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "lint": "eslint src prisma test scripts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@flashlab/contracts": "workspace:*",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.16.0",
    "dotenv": "^17.2.0",
    "pino-http": "^11.0.0",
    "pino": "^10.0.0",
    "@nestjs/swagger": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "concurrently": "^9.2.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "@types/pg": "^8.15.0",
    "pino-pretty": "^13.0.0"
  }
}
